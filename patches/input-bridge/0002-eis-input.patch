diff --git a/tests/keyboard_modifiers_test.cpp b/tests/keyboard_modifiers_test.cpp
new file mode 100644
index 0000000..1ea74da
--- /dev/null
+++ b/tests/keyboard_modifiers_test.cpp
@@ -0,0 +1,42 @@
+#include "keyboard_modifiers.hpp"
+
+#include <cstdlib>
+#include <iostream>
+#include <linux/input-event-codes.h>
+
+int main() {
+    auto* context = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
+    const xkb_rule_names names{.rules = nullptr, .model = nullptr, .layout = "us", .variant = nullptr, .options = nullptr};
+    auto* keymap = xkb_keymap_new_from_names(context, &names, XKB_KEYMAP_COMPILE_NO_FLAGS);
+    auto* state = keymap ? xkb_state_new(keymap) : nullptr;
+    if (!state)
+        return EXIT_FAILURE;
+
+    int failures = 0;
+    auto expect = [&](bool condition, const char* message) {
+        if (!condition) {
+            std::cerr << message << '\n';
+            ++failures;
+        }
+    };
+    const auto shift = 1u << xkb_keymap_mod_get_index(keymap, XKB_MOD_NAME_SHIFT);
+    const auto ctrl = 1u << xkb_keymap_mod_get_index(keymap, XKB_MOD_NAME_CTRL);
+    const auto caps = 1u << xkb_keymap_mod_get_index(keymap, XKB_MOD_NAME_CAPS);
+    auto mods = hkcf::updateKeyboardModifiers(state, KEY_LEFTSHIFT, true);
+    expect((mods.depressed & shift) != 0, "Shift must become active on evdev press");
+    mods = hkcf::updateKeyboardModifiers(state, KEY_LEFTCTRL, true);
+    expect((mods.depressed & (shift | ctrl)) == (shift | ctrl), "Ctrl+Shift must retain both modifiers");
+    mods = hkcf::updateKeyboardModifiers(state, KEY_LEFTSHIFT, false);
+    expect((mods.depressed & shift) == 0 && (mods.depressed & ctrl) != 0, "releasing Shift must preserve Ctrl");
+    mods = hkcf::updateKeyboardModifiers(state, KEY_LEFTCTRL, false);
+    expect(mods.depressed == 0, "released modifiers must not stick");
+    hkcf::updateKeyboardModifiers(state, KEY_CAPSLOCK, true);
+    mods = hkcf::updateKeyboardModifiers(state, KEY_CAPSLOCK, false);
+    expect((mods.locked & caps) != 0, "Caps Lock must survive release as locked, not depressed");
+    expect(mods.depressed == 0, "Caps Lock release must clear depressed state");
+
+    xkb_state_unref(state);
+    xkb_keymap_unref(keymap);
+    xkb_context_unref(context);
+    return failures ? EXIT_FAILURE : EXIT_SUCCESS;
+}
