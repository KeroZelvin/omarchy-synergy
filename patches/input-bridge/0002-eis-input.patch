new file mode 100644
index 0000000..d2b2f13
--- /dev/null
+++ b/src/keyboard_modifiers.hpp
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <cstdint>
+#include <xkbcommon/xkbcommon.h>
+
+namespace hkcf {
+
+struct KeyboardModifiers {
+    xkb_mod_mask_t depressed;
+    xkb_mod_mask_t latched;
+    xkb_mod_mask_t locked;
+    xkb_layout_index_t group;
+};
+
+// libei and virtual-keyboard use evdev codes; xkbcommon adds eight.
+inline KeyboardModifiers updateKeyboardModifiers(xkb_state* state, std::uint32_t keycode, bool pressed) {
+    xkb_state_update_key(state, keycode + 8, pressed ? XKB_KEY_DOWN : XKB_KEY_UP);
+    return {
+        xkb_state_serialize_mods(state, XKB_STATE_MODS_DEPRESSED),
+        xkb_state_serialize_mods(state, XKB_STATE_MODS_LATCHED),
+        xkb_state_serialize_mods(state, XKB_STATE_MODS_LOCKED),
+        xkb_state_serialize_layout(state, XKB_STATE_LAYOUT_EFFECTIVE),
+    };
+}
+
+} // namespace hkcf
