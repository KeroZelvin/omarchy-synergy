+
 #include <algorithm>
 #include <optional>
 
@@ -111,7 +114,12 @@ QString executablePathForBusService(const QDBusConnection& connection, const QSt
     if (!pid.isValid() || pid.value() == 0)
         return {};
 
-    return QFileInfo(QStringLiteral("/proc/%1/exe").arg(pid.value())).symLinkTarget();
+    const auto procPath = QStringLiteral("/proc/%1/exe").arg(pid.value()).toLocal8Bit();
+    std::array<char, 4096> target;
+    const auto length = ::readlink(procPath.constData(), target.data(), target.size());
+    if (length < 0 || static_cast<std::size_t>(length) == target.size())
+        return {};
+    return QString::fromLocal8Bit(target.data(), length);
 }
 
 bool serviceOwnsKdeConnectName(const QDBusConnection& connection, const QString& serviceName) {
@@ -716,10 +724,15 @@ bool PortalBackend::isAllowedApp(const QString& appId, const QString& sessionPat
     if (!senderBusName)
         return false;
 
+    const QString verifiedExecutable = executablePathForBusService(connection, *senderBusName);
+    if (security::isAllowedSynergyExecutablePath(verifiedExecutable)) {
+        qInfo() << "allowing native Synergy core session";
+        return true;
+    }
     if (!serviceOwnsKdeConnectName(connection, *senderBusName))
         return false;
 
-    const QString executablePath = executablePathForBusService(connection, *senderBusName);
+    const QString executablePath = verifiedExecutable;
     if (!security::isAllowedFallbackExecutablePath(executablePath))
         return false;
 
