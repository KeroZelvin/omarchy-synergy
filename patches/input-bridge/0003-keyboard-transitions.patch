     return {
         xkb_state_serialize_mods(state, XKB_STATE_MODS_DEPRESSED),
         xkb_state_serialize_mods(state, XKB_STATE_MODS_LATCHED),
diff --git a/src/keyboard_state.hpp b/src/keyboard_state.hpp
new file mode 100644
index 0000000..496c1aa
--- /dev/null
+++ b/src/keyboard_state.hpp
@@ -0,0 +1,32 @@
+#pragma once
+
+#include <cstdint>
+#include <set>
+#include <xkbcommon/xkbcommon.h>
+
+namespace hkcf {
+
+// XKB counts repeated down events. Only physical state transitions may update it.
+class KeyboardState {
+  public:
+    explicit KeyboardState(xkb_keymap* keymap) : m_state(xkb_state_new(keymap)) {}
+    ~KeyboardState() { if (m_state) xkb_state_unref(m_state); }
+    KeyboardState(const KeyboardState&) = delete;
+    KeyboardState& operator=(const KeyboardState&) = delete;
+
+    xkb_state* get() const { return m_state; }
+
+    bool update(std::uint32_t evdevCode, bool pressed) {
+        if (!m_state) return false;
+        const bool changed = pressed ? m_pressed.insert(evdevCode).second : m_pressed.erase(evdevCode) != 0;
+        if (changed)
+            xkb_state_update_key(m_state, evdevCode + 8, pressed ? XKB_KEY_DOWN : XKB_KEY_UP);
+        return changed;
+    }
+
+  private:
+    xkb_state* m_state = nullptr;
+    std::set<std::uint32_t> m_pressed;
+};
+
+} // namespace hkcf
