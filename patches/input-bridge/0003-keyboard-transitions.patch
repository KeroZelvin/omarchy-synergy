diff --git a/tests/keyboard_state_test.cpp b/tests/keyboard_state_test.cpp
new file mode 100644
index 0000000..da9ae81
--- /dev/null
+++ b/tests/keyboard_state_test.cpp
@@ -0,0 +1,56 @@
+#include "keyboard_state.hpp"
+
+#include <cstdlib>
+#include <iostream>
+#include <linux/input-event-codes.h>
+
+int main() {
+    auto* context = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
+    if (!context) return EXIT_FAILURE;
+    const xkb_rule_names names{.rules = nullptr, .model = nullptr, .layout = "us", .variant = nullptr, .options = nullptr};
+    auto* keymap = xkb_keymap_new_from_names(context, &names, XKB_KEYMAP_COMPILE_NO_FLAGS);
+    if (!keymap) return EXIT_FAILURE;
+    hkcf::KeyboardState state(keymap);
+    int failures = 0;
+    auto expect = [&](bool ok, const char* message) {
+        if (!ok) { std::cerr << "FAIL: " << message << '\n'; ++failures; }
+    };
+    auto mods = [&]() { return xkb_state_serialize_mods(state.get(), XKB_STATE_MODS_DEPRESSED); };
+    auto sym = [&](unsigned key) { return xkb_state_key_get_one_sym(state.get(), key + 8); };
+
+    // The original bridge updated XKB twice, requiring two releases for Shift.
+    for (auto key : {KEY_LEFTSHIFT, KEY_RIGHTSHIFT, KEY_LEFTMETA, KEY_RIGHTMETA, KEY_LEFTCTRL, KEY_LEFTALT}) {
+        expect(state.update(key, true), "first modifier down must be delivered");
+        expect(mods() != 0, "modifier must become active");
+        expect(!state.update(key, true), "duplicate modifier down must be ignored");
+        expect(state.update(key, false), "single release must be delivered");
+        expect(mods() == 0, "single release must clear repeated modifier");
+        expect(!state.update(key, false), "unmatched release must be ignored");
+    }
+
+    state.update(KEY_LEFTSHIFT, true);
+    expect(sym(KEY_1) == XKB_KEY_exclam, "Shift must still produce symbols");
+    state.update(KEY_RIGHTSHIFT, true);
+    state.update(KEY_LEFTSHIFT, false);
+    expect(sym(KEY_1) == XKB_KEY_exclam, "other Shift must remain held");
+    state.update(KEY_RIGHTSHIFT, false);
+    expect(sym(KEY_1) == XKB_KEY_1, "number row must return to digits");
+    expect(sym(KEY_ENTER) == XKB_KEY_Return && mods() == 0, "Enter must be unmodified after cleanup");
+
+    expect(state.update(KEY_ENTER, true), "Enter down must be delivered");
+    expect(!state.update(KEY_ENTER, true), "repeat must not accumulate pressed state");
+    expect(state.update(KEY_ENTER, false), "Enter release must be delivered");
+    expect(state.update(KEY_ENTER, true), "Enter must work again after release");
+    state.update(KEY_ENTER, false);
+
+    state.update(KEY_NUMLOCK, true);
+    state.update(KEY_NUMLOCK, false);
+    const auto locked = xkb_state_serialize_mods(state.get(), XKB_STATE_MODS_LOCKED);
+    state.update(KEY_LEFTSHIFT, true);
+    state.update(KEY_LEFTSHIFT, false);
+    expect(locked != 0 && xkb_state_serialize_mods(state.get(), XKB_STATE_MODS_LOCKED) == locked,
+           "modifier cleanup must preserve NumLock");
+    xkb_keymap_unref(keymap);
+    xkb_context_unref(context);
+    return failures ? EXIT_FAILURE : EXIT_SUCCESS;
+}
